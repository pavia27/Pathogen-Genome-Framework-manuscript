group_by(pattern) %>%
summarise(mutations = list(mutation), .groups = "drop") %>%
mutate(group_id = paste0("mutgrp_", row_number()))
group_map
h[group_map$group_id] <- lapply(group_map$mutations, function(x) h[[x[1]]])
h <- h[, !(names(h) %in% i), drop = FALSE]
